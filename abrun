#!/usr/bin/env python3
"""Submit an exact operation to AB master; never approves or executes locally."""
import argparse
import json
import os
import sys
from ab_master import exchange

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--socket', default=os.environ.get('AB_SOCKET', '/tmp/ab-submit.sock'))
parser.add_argument('--reason', default='')
parser.add_argument('command', nargs=argparse.REMAINDER)
args = parser.parse_args()
argv = args.command[1:] if args.command[:1] == ['--'] else args.command
if not argv:
    parser.error('a command is required')
try:
    result = exchange(args.socket, {'action': 'submit', 'argv': argv, 'cwd': os.getcwd(), 'reason': args.reason})
except (OSError, ValueError) as exc:
    print('abrun: ' + str(exc), file=sys.stderr)
    sys.exit(1)
print(json.dumps(result, indent=2))
sys.exit(0 if result.get('ok') else 1)

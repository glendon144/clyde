{
  "admission_rules": {
    "_comment": "Ordered, first match wins, deny by default. This gate runs BEFORE role/provider/budget checks and does not replace them.",
    "default": "deny",
    "rules": [
      {
        "decision": "deny",
        "name": "deny_unknown_user",
        "reason": "only the broker owner may submit tasks",
        "when": "user != 'gross'"
      },
      {
        "decision": "deny",
        "name": "deny_shell_outside_home",
        "reason": "shell tasks are confined to the owner's home tree",
        "when": "task_type == 'shell' and not path_under(cwd, '/Users/gross')"
      },
      {
        "decision": "deny",
        "name": "deny_oversized_swarm",
        "reason": "declared agent fan-out exceeds the hard ceiling",
        "when": "agent_count > 8"
      },
      {
        "decision": "deny",
        "name": "deny_system_level_commands",
        "reason": "system-level commands are never brokered",
        "when": "task_type == 'shell' and len(argv) > 0 and any_of(argv[0], ['dd', 'mkfs', 'fdisk', 'diskutil', 'shutdown', 'reboot', 'halt'])"
      },
      {
        "decision": "deny",
        "name": "deny_recursive_force_delete",
        "reason": "recursive force delete must be run by a human, not brokered",
        "when": "task_type == 'shell' and startswith(command, 'rm ') and (contains(command, ' -rf') or contains(command, ' -fr') or contains(command, ' -r '))"
      },
      {
        "decision": "allow",
        "name": "allow_read_only_shell",
        "reason": "read-only shell inspection is permitted",
        "when": "task_type == 'shell' and len(argv) > 0 and any_of(argv[0], ['ls', 'pwd', 'head', 'cat', 'grep', 'find'])"
      },
      {
        "decision": "allow",
        "name": "allow_maintainer_shell",
        "reason": "maintainer may run shell tasks subject to role policy",
        "when": "task_type == 'shell' and role == 'maintainer'"
      },
      {
        "decision": "allow",
        "name": "allow_llm_tasks",
        "reason": "model inference is permitted subject to budget and routing",
        "when": "task_type == 'llm'"
      },
      {
        "decision": "allow",
        "name": "allow_ocr_tasks",
        "reason": "OCR extraction is permitted",
        "when": "task_type == 'ocr'"
      },
      {
        "decision": "allow",
        "name": "allow_maintainer_mcp",
        "reason": "maintainer may reach configured MCP servers",
        "when": "task_type == 'mcp' and role == 'maintainer'"
      },
      {
        "decision": "allow",
        "name": "allow_dream_milestone",
        "reason": "explicit Dream milestone capture is permitted",
        "when": "task_type == 'dream' and intent == 'store_milestone' and role == 'maintainer'"
      }
    ]
  },
  "agent_controls": {
    "default_max_child_tasks": 0,
    "hard_max_child_tasks": 8,
    "require_explicit_swarm_approval": true
  },
  "budget": {
    "daily_global_limit": 5.0,
    "per_task_limit": 0.25,
    "provider_daily_limits": {
      "anthropic": 2.0,
      "baseten": 2.0,
      "deepseek": 2.0,
      "dream_rest": 0.0,
      "google_vision": 1.0,
      "local": 0.0,
      "mcp_openbrain": 0.0,
      "openai": 3.0,
      "shell": 0.0
    },
    "provider_per_task_limits": {
      "anthropic": 0.25,
      "baseten": 0.1,
      "deepseek": 0.05,
      "dream_rest": 0.0,
      "google_vision": 0.05,
      "local": 0.0,
      "mcp_openbrain": 0.0,
      "openai": 0.1,
      "shell": 0.0
    },
    "risk_tier_per_task_limits": {
      "external_inference": 0.05,
      "external_read": 0.0,
      "external_write": 0.0,
      "file_read": 0.05,
      "shell_safe": 0.0
    }
  },
  "default": "deny",
  "enforcement": {
    "_comment": "strict: broker decision is final. permissive: denied requests may fall back to mcp_proxy. Override per-run with --strict/--permissive.",
    "mode": "strict"
  },
  "fallback": {
    "_comment": "Only consulted in permissive mode. Shell tasks can never fall back; that guard is in code, not here.",
    "allow_task_types": [
      "mcp"
    ],
    "enabled": true,
    "mcp_proxy": {
      "timeout": 30,
      "url": "http://127.0.0.1:3000"
    },
    "on_execution_failure": false,
    "on_policy_denial": true
  },
  "mcp_servers": {
    "clones_brain": {
      "_comment": "DISABLED: clones_brain_mcp serves SSE. The broker's MCP adapter speaks one-shot JSON-RPC POST only. Enable once either the adapter learns SSE or the server moves to streamable-http.",
      "auth_header": "x-brain-key",
      "enabled": false,
      "tools": [
        "capture_thought",
        "search_thoughts",
        "recover_context",
        "list_recent",
        "health"
      ],
      "transport": "sse",
      "url": "http://127.0.0.1:3001"
    },
    "openbrain": {
      "auth_header": "x-brain-key",
      "token_file": "~/open-brain/claude_mcp_token",
      "tools": [
        "capture_thought",
        "search_thoughts",
        "list_thoughts",
        "thought_stats"
      ],
      "url": "https://lylmeseyluezpvclnllt.supabase.co/functions/v1/open-brain-mcp"
    }
  },
  "prefetch": [
    {
      "enabled": true,
      "intent": "summarize",
      "payload": {
        "text": "Warm the cache with a startup summary for the AI Broker README."
      },
      "provider": "local",

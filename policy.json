          "analyze",
          "classify",
          "vision"
        ],
        "mcp": [
          "capture_thought",
          "search_thoughts",
          "list_thoughts",
          "thought_stats"
        ],
        "ocr": [
          "ocr_extract"
        ],
        "shell": [
          "*"
        ]
      },
      "deny_providers": [],

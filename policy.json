  "roles": {
    "developer": {
      "allow_paths": [
        "./",
        "./src",
        "./modules"
      ],
      "allow_providers": [
        "local",
        "openai",
        "deepseek",
        "baseten",
        "google_vision",
        "shell"
      ],
      "allow_tasks": {
        "llm": [
          "summarize",
          "analyze",
          "classify"
        ],
        "ocr": [
          "ocr_extract"
        ],
        "shell": {
          "cat": {
            "max_positionals": 2,
            "min_positionals": 1
          },
          "find": {
            "max_positionals": 2,
            "min_positionals": 1,
            "options_with_values": {
              "-maxdepth": {
                "type": "int"
              },
              "-name": {
                "type": "any"
              },
              "-type": {
                "values": [
                  "f",
                  "d"
                ]
              }
            }
          },
          "grep": {
            "allowed_flags": [
              "-n",
              "-i"
            ],
            "max_positionals": 2,
            "min_positionals": 2
          },
          "head": {
            "max_positionals": 1,
            "min_positionals": 1,
            "options_with_values": {
              "-n": {
                "type": "int"
              }
            }
          },
          "ls": {
            "allowed_flags": [
              "-a",
              "-l",
              "-la",
              "-al"
            ],
            "max_positionals": 2
          },
          "pwd": {
            "allow_positionals": false
          }
        }
      },
      "deny_providers": [
        "anthropic",
        "dream_rest",
        "mcp_openbrain"
      ],
      "read_only": true
    },
    "guest": {
      "allow_paths": [
        "./docs",
        "./README.md",
        "./"
      ],
      "allow_providers": [
        "local",
        "shell"
      ],
      "allow_tasks": {
        "llm": [
          "summarize"
        ],
        "ocr": false,
        "shell": {
          "head": {
            "max_positionals": 1,
            "min_positionals": 1,
            "options_with_values": {
              "-n": {
                "type": "int"
              }
            }
          },
          "ls": {
            "allowed_flags": [
              "-a",
              "-l",
              "-la",
              "-al"
            ],
            "max_positionals": 1
          },
          "pwd": {
            "allow_positionals": false
          }
        }
      },
      "deny_providers": [
        "anthropic",
        "google_vision",
        "openai",
        "deepseek",
        "baseten",
        "dream_rest",
        "mcp_openbrain"
      ],
      "read_only": true
    },
    "maintainer": {
      "allow_paths": [
        "./"
      ],
      "allow_providers": [
        "*"
      ],
      "allow_tasks": {
        "dream": [
          "store_milestone"
